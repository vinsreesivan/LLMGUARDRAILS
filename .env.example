# NebulaGateAI Environment Variables

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=production
PORT=3699

# ===========================================
# Guardrails.AI Configuration
# ===========================================
# Get your JWT token by running: guardrails configure
# Or get it from: https://hub.guardrailsai.com/
GUARDRAILS_TOKEN=your_jwt_token_here
GUARDRAILS_BASE_URL=https://api.guardrailsai.com
GUARDRAILS_HOST=localhost
GUARDRAILS_PORT=8000

# ===========================================
# LLM API Keys
# ===========================================
# OpenAI API Key (for GPT-3.5, GPT-4, etc.)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude models)
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Cohere API Key
# Get it from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...

# ===========================================
# NVIDIA NeMo Guardrails Configuration
# ===========================================
# NVIDIA API Key (for NIM models)
# Get it from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# NeMo Guardrails Server
NEMO_HOST=localhost
NEMO_PORT=8001

# Enable NemoGuard jailbreak detection
NEMO_JAILBREAK_DETECTION=true

# Enable content safety moderation
NEMO_CONTENT_SAFETY=true

# ===========================================
# Ollama Configuration (Local LLM)
# ===========================================
# Ollama server settings (for local LLM deployment)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model to use
OLLAMA_MODEL=llama3

# ===========================================
# Docker Configuration
# ===========================================
# Set to 'true' to enable GPU support for Ollama
OLLAMA_GPU_ENABLED=false

# NVIDIA GPU device IDs (comma-separated, e.g., "0,1")
NVIDIA_VISIBLE_DEVICES=all
